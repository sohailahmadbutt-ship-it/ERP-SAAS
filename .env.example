# Postgres runs as a non-superuser role so row-level security is enforced
DATABASE_URL=postgresql://erp_app:erp_app@localhost:5432/erp
JWT_SECRET=change-me
API_PORT=4000
# Root domain tenants live under, e.g. acme.localhost or acme.yourerp.com
ROOT_DOMAIN=localhost
NEXT_PUBLIC_API_URL=http://localhost:4000

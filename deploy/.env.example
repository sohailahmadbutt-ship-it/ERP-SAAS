# Copy to .env and fill in. Never commit .env.

# Main domain. Companies live at <company>.ROOT_DOMAIN and the API at api.ROOT_DOMAIN.
# DNS: point ROOT_DOMAIN and *.ROOT_DOMAIN (A records) at this server.
ROOT_DOMAIN=erp.example.com
# Let's Encrypt contact for certificate expiry notices.
ACME_EMAIL=you@example.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=

# Shown to companies on their open invoice.
PAYMENT_INSTRUCTIONS="Pay by bank transfer to: Your Bank, Account title, IBAN PK00XXXX0000000000000000"

# Local ports, used only when an existing nginx/Apache proxies to the app instead of Caddy.
WEB_LOCAL_PORT=3100
API_LOCAL_PORT=4100

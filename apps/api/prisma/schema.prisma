generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A company that subscribes to the platform. Not tenant-scoped itself.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  plan      String   @default("trial")
  currency  String   @default("PKR")
  /// Tax registration number, e.g. NTN / STRN in Pakistan
  taxId     String?  @map("tax_id")
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?  @default("PK")
  createdAt DateTime @default(now()) @map("created_at")
  users      User[]
  contacts   Contact[]
  units      Unit[]
  products   Product[]
  warehouses Warehouse[]
  stockMoves StockMove[]

  @@map("tenants")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Tenant-scoped: protected by the row-level security policy on tenant_id.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, email])
  @@map("users")
}

enum ContactKind {
  COMPANY
  PERSON
}

/// Tenant-scoped: customers, vendors and the people who work at them.
model Contact {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        ContactKind @default(COMPANY)
  name        String
  /// A person can belong to a company contact.
  parentId    String?     @map("parent_id") @db.Uuid
  parent      Contact?    @relation("ContactChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Contact[]   @relation("ContactChildren")
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  taxId       String?     @map("tax_id")
  isCustomer  Boolean     @default(false) @map("is_customer")
  isVendor    Boolean     @default(false) @map("is_vendor")
  creditLimit Decimal?    @map("credit_limit") @db.Decimal(14, 2)
  notes       String?
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([tenantId, name])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Inventory. Tenant-scoped tables reference each other through composite
// (id, tenant_id) foreign keys, so the database itself refuses a link to a
// row that belongs to another company (plain foreign key checks bypass RLS).
// ---------------------------------------------------------------------------

/// Unit of measure, e.g. pcs, kg, box.
model Unit {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  code     String
  products Product[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@map("units")
}

enum ProductType {
  GOODS
  SERVICE
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  barcode     String?
  type        ProductType @default(GOODS)
  unitId      String      @map("unit_id") @db.Uuid
  unit        Unit        @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: NoAction)
  salePrice   Decimal     @default(0) @map("sale_price") @db.Decimal(14, 2)
  cost        Decimal     @default(0) @db.Decimal(14, 2)
  description String?
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  moves       StockMove[]

  @@unique([id, tenantId])
  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("products")
}

model Warehouse {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  address   String?
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at")
  moves     StockMove[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@map("warehouses")
}

enum StockMoveType {
  RECEIPT
  DELIVERY
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

/// Append-only ledger of stock changes. On-hand quantity is the sum of
/// `quantity` (positive in, negative out) per product and warehouse.
model StockMove {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String        @map("product_id") @db.Uuid
  product     Product       @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: NoAction)
  warehouseId String        @map("warehouse_id") @db.Uuid
  warehouse   Warehouse     @relation(fields: [warehouseId, tenantId], references: [id, tenantId], onDelete: NoAction)
  type        StockMoveType
  quantity    Decimal       @db.Decimal(14, 3)
  unitCost    Decimal?      @map("unit_cost") @db.Decimal(14, 2)
  /// Links the two halves of a transfer.
  transferId  String?       @map("transfer_id") @db.Uuid
  reference   String?
  note        String?
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, createdAt])
  @@map("stock_moves")
}

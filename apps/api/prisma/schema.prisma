generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A company that subscribes to the platform. Not tenant-scoped itself.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  plan      String   @default("business")
  planRef   Plan     @relation(fields: [plan], references: [code])
  status    SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime? @map("trial_ends_at")
  /// End of the last paid period. Writes are allowed for a short grace period after it.
  currentPeriodEnd DateTime? @map("current_period_end")
  /// Shown to the company when the platform suspends it.
  statusNote       String?   @map("status_note")
  currency  String   @default("PKR")
  /// Tax registration number, e.g. NTN / STRN in Pakistan
  taxId     String?  @map("tax_id")
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?  @default("PK")
  createdAt DateTime @default(now()) @map("created_at")
  users      User[]
  contacts   Contact[]
  units      Unit[]
  products   Product[]
  warehouses Warehouse[]
  stockMoves StockMove[]
  taxes      Tax[]
  sequences  Sequence[]
  salesOrders SalesOrder[]
  salesOrderLines SalesOrderLine[]
  invoices   Invoice[]
  invoiceLines InvoiceLine[]
  payments   Payment[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  bills      Bill[]
  billLines  BillLine[]
  billPayments BillPayment[]
  accounts   Account[]
  journalEntries JournalEntry[]
  journalLines JournalLine[]
  platformInvoices PlatformInvoice[]
  posRegisters PosRegister[]
  posSessions  PosSession[]
  posOrders    PosOrder[]
  posOrderLines PosOrderLine[]
  posPayments  PosPayment[]
  crmStages    CrmStage[]
  crmLeads     CrmLead[]
  crmActivities CrmActivity[]

  @@map("tenants")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Tenant-scoped: protected by the row-level security policy on tenant_id.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, email])
  @@map("users")
}

enum ContactKind {
  COMPANY
  PERSON
}

/// Tenant-scoped: customers, vendors and the people who work at them.
model Contact {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        ContactKind @default(COMPANY)
  name        String
  /// A person can belong to a company contact.
  parentId    String?     @map("parent_id") @db.Uuid
  parent      Contact?    @relation("ContactChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Contact[]   @relation("ContactChildren")
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  taxId       String?     @map("tax_id")
  isCustomer  Boolean     @default(false) @map("is_customer")
  isVendor    Boolean     @default(false) @map("is_vendor")
  creditLimit Decimal?    @map("credit_limit") @db.Decimal(14, 2)
  notes       String?
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  salesOrders SalesOrder[]
  invoices    Invoice[]
  purchaseOrders PurchaseOrder[]
  bills       Bill[]
  journalLines JournalLine[]
  posOrders   PosOrder[]
  crmLeads    CrmLead[]

  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Inventory. Tenant-scoped tables reference each other through composite
// (id, tenant_id) foreign keys, so the database itself refuses a link to a
// row that belongs to another company (plain foreign key checks bypass RLS).
// ---------------------------------------------------------------------------

/// Unit of measure, e.g. pcs, kg, box.
model Unit {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  code     String
  products Product[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@map("units")
}

enum ProductType {
  GOODS
  SERVICE
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  barcode     String?
  type        ProductType @default(GOODS)
  unitId      String      @map("unit_id") @db.Uuid
  unit        Unit        @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: NoAction)
  salePrice   Decimal     @default(0) @map("sale_price") @db.Decimal(14, 2)
  cost        Decimal     @default(0) @db.Decimal(14, 2)
  description String?
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  moves       StockMove[]
  orderLines   SalesOrderLine[]
  invoiceLines InvoiceLine[]
  purchaseLines PurchaseOrderLine[]
  billLines    BillLine[]
  posLines     PosOrderLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@map("products")
}

model Warehouse {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  address   String?
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at")
  moves     StockMove[]
  salesOrders SalesOrder[]
  purchaseOrders PurchaseOrder[]
  posRegisters PosRegister[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@map("warehouses")
}

enum StockMoveType {
  RECEIPT
  DELIVERY
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

/// Append-only ledger of stock changes. On-hand quantity is the sum of
/// `quantity` (positive in, negative out) per product and warehouse.
model StockMove {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String        @map("product_id") @db.Uuid
  product     Product       @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: NoAction)
  warehouseId String        @map("warehouse_id") @db.Uuid
  warehouse   Warehouse     @relation(fields: [warehouseId, tenantId], references: [id, tenantId], onDelete: NoAction)
  type        StockMoveType
  quantity    Decimal       @db.Decimal(14, 3)
  unitCost    Decimal?      @map("unit_cost") @db.Decimal(14, 2)
  /// Links the two halves of a transfer.
  transferId  String?       @map("transfer_id") @db.Uuid
  reference   String?
  note        String?
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, createdAt])
  @@map("stock_moves")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

/// A sales tax rate, e.g. GST 18%.
model Tax {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  /// Percentage, e.g. 18 for 18%.
  rate         Decimal          @db.Decimal(6, 3)
  archived     Boolean          @default(false)
  orderLines   SalesOrderLine[]
  invoiceLines InvoiceLine[]
  purchaseLines PurchaseOrderLine[]
  billLines    BillLine[]
  posRegisters PosRegister[]

  @@unique([id, tenantId])
  @@map("taxes")
}

/// Per-company document counters (SO-00001, INV-00001).
model Sequence {
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key      String
  next     Int    @default(1)

  @@id([tenantId, key])
  @@map("sequences")
}

enum SalesOrderStatus {
  QUOTATION
  CONFIRMED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String
  status      SalesOrderStatus @default(QUOTATION)
  customerId  String           @map("customer_id") @db.Uuid
  customer    Contact          @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: NoAction)
  warehouseId String           @map("warehouse_id") @db.Uuid
  warehouse   Warehouse        @relation(fields: [warehouseId, tenantId], references: [id, tenantId], onDelete: NoAction)
  orderDate   DateTime         @default(now()) @map("order_date") @db.Date
  validUntil  DateTime?        @map("valid_until") @db.Date
  currency    String
  notes       String?
  subtotal    Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal          @default(0) @map("tax_total") @db.Decimal(14, 2)
  total       Decimal          @default(0) @db.Decimal(14, 2)
  confirmedAt DateTime?        @map("confirmed_at")
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  lines       SalesOrderLine[]
  invoices    Invoice[]
  crmLeads    CrmLead[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId      String        @map("order_id") @db.Uuid
  order        SalesOrder    @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  position     Int
  productId    String        @map("product_id") @db.Uuid
  product      Product       @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: NoAction)
  description  String
  quantity     Decimal       @db.Decimal(14, 3)
  unitPrice    Decimal       @map("unit_price") @db.Decimal(14, 2)
  discountPct  Decimal       @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxId        String?       @map("tax_id") @db.Uuid
  tax          Tax?          @relation(fields: [taxId, tenantId], references: [id, tenantId], onDelete: NoAction)
  taxRate      Decimal       @default(0) @map("tax_rate") @db.Decimal(6, 3)
  subtotal     Decimal       @db.Decimal(14, 2)
  taxAmount    Decimal       @map("tax_amount") @db.Decimal(14, 2)
  total        Decimal       @db.Decimal(14, 2)
  deliveredQty Decimal       @default(0) @map("delivered_qty") @db.Decimal(14, 3)
  invoicedQty  Decimal       @default(0) @map("invoiced_qty") @db.Decimal(14, 3)
  invoiceLines InvoiceLine[]

  @@unique([id, tenantId])
  @@index([tenantId, orderId])
  @@map("sales_order_lines")
}

enum InvoiceStatus {
  DRAFT
  POSTED
  PAID
  CANCELLED
}

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Assigned when the invoice is posted, so posted numbers have no gaps.
  number      String?
  status      InvoiceStatus @default(DRAFT)
  customerId  String        @map("customer_id") @db.Uuid
  customer    Contact       @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: NoAction)
  orderId     String?       @map("order_id") @db.Uuid
  order       SalesOrder?   @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: NoAction)
  invoiceDate DateTime      @default(now()) @map("invoice_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  currency    String
  notes       String?
  subtotal    Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  total       Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid  Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  postedAt    DateTime?     @map("posted_at")
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  lines       InvoiceLine[]
  payments    Payment[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String          @map("invoice_id") @db.Uuid
  invoice     Invoice         @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  position    Int
  productId   String          @map("product_id") @db.Uuid
  product     Product         @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: NoAction)
  orderLineId String?         @map("order_line_id") @db.Uuid
  orderLine   SalesOrderLine? @relation(fields: [orderLineId, tenantId], references: [id, tenantId], onDelete: NoAction)
  description String
  quantity    Decimal         @db.Decimal(14, 3)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(14, 2)
  discountPct Decimal         @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxId       String?         @map("tax_id") @db.Uuid
  tax         Tax?            @relation(fields: [taxId, tenantId], references: [id, tenantId], onDelete: NoAction)
  taxRate     Decimal         @default(0) @map("tax_rate") @db.Decimal(6, 3)
  subtotal    Decimal         @db.Decimal(14, 2)
  taxAmount   Decimal         @map("tax_amount") @db.Decimal(14, 2)
  total       Decimal         @db.Decimal(14, 2)

  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String   @map("invoice_id") @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: NoAction)
  paymentDate DateTime @default(now()) @map("payment_date") @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  method      String
  reference   String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  RFQ
  CONFIRMED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number       String
  status       PurchaseOrderStatus @default(RFQ)
  vendorId     String              @map("vendor_id") @db.Uuid
  vendor       Contact             @relation(fields: [vendorId, tenantId], references: [id, tenantId], onDelete: NoAction)
  /// Warehouse goods are received into.
  warehouseId  String              @map("warehouse_id") @db.Uuid
  warehouse    Warehouse           @relation(fields: [warehouseId, tenantId], references: [id, tenantId], onDelete: NoAction)
  orderDate    DateTime            @default(now()) @map("order_date") @db.Date
  expectedDate DateTime?           @map("expected_date") @db.Date
  vendorRef    String?             @map("vendor_ref")
  currency     String
  notes        String?
  subtotal     Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal     Decimal             @default(0) @map("tax_total") @db.Decimal(14, 2)
  total        Decimal             @default(0) @db.Decimal(14, 2)
  confirmedAt  DateTime?           @map("confirmed_at")
  createdById  String              @map("created_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  lines        PurchaseOrderLine[]
  bills        Bill[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     String        @map("order_id") @db.Uuid
  order       PurchaseOrder @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  position    Int
  productId   String        @map("product_id") @db.Uuid
  product     Product       @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: NoAction)
  description String
  quantity    Decimal       @db.Decimal(14, 3)
  unitPrice   Decimal       @map("unit_price") @db.Decimal(14, 2)
  discountPct Decimal       @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxId       String?       @map("tax_id") @db.Uuid
  tax         Tax?          @relation(fields: [taxId, tenantId], references: [id, tenantId], onDelete: NoAction)
  taxRate     Decimal       @default(0) @map("tax_rate") @db.Decimal(6, 3)
  subtotal    Decimal       @db.Decimal(14, 2)
  taxAmount   Decimal       @map("tax_amount") @db.Decimal(14, 2)
  total       Decimal       @db.Decimal(14, 2)
  receivedQty Decimal       @default(0) @map("received_qty") @db.Decimal(14, 3)
  billedQty   Decimal       @default(0) @map("billed_qty") @db.Decimal(14, 3)
  billLines   BillLine[]

  @@unique([id, tenantId])
  @@index([tenantId, orderId])
  @@map("purchase_order_lines")
}

enum BillStatus {
  DRAFT
  POSTED
  PAID
  CANCELLED
}

/// A vendor's invoice to us.
model Bill {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Our number, assigned when posted.
  number      String?
  /// The vendor's own invoice number.
  vendorRef   String?       @map("vendor_ref")
  status      BillStatus    @default(DRAFT)
  vendorId    String        @map("vendor_id") @db.Uuid
  vendor      Contact       @relation(fields: [vendorId, tenantId], references: [id, tenantId], onDelete: NoAction)
  orderId     String?       @map("order_id") @db.Uuid
  order       PurchaseOrder? @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: NoAction)
  billDate    DateTime      @default(now()) @map("bill_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  currency    String
  notes       String?
  subtotal    Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  total       Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid  Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  postedAt    DateTime?     @map("posted_at")
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  lines       BillLine[]
  payments    BillPayment[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@map("bills")
}

model BillLine {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billId      String             @map("bill_id") @db.Uuid
  bill        Bill               @relation(fields: [billId, tenantId], references: [id, tenantId], onDelete: Cascade)
  position    Int
  productId   String             @map("product_id") @db.Uuid
  product     Product            @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: NoAction)
  orderLineId String?            @map("order_line_id") @db.Uuid
  orderLine   PurchaseOrderLine? @relation(fields: [orderLineId, tenantId], references: [id, tenantId], onDelete: NoAction)
  description String
  quantity    Decimal            @db.Decimal(14, 3)
  unitPrice   Decimal            @map("unit_price") @db.Decimal(14, 2)
  discountPct Decimal            @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxId       String?            @map("tax_id") @db.Uuid
  tax         Tax?               @relation(fields: [taxId, tenantId], references: [id, tenantId], onDelete: NoAction)
  taxRate     Decimal            @default(0) @map("tax_rate") @db.Decimal(6, 3)
  subtotal    Decimal            @db.Decimal(14, 2)
  taxAmount   Decimal            @map("tax_amount") @db.Decimal(14, 2)
  total       Decimal            @db.Decimal(14, 2)

  @@index([tenantId, billId])
  @@map("bill_lines")
}

model BillPayment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billId      String   @map("bill_id") @db.Uuid
  bill        Bill     @relation(fields: [billId, tenantId], references: [id, tenantId], onDelete: NoAction)
  paymentDate DateTime @default(now()) @map("payment_date") @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  method      String
  reference   String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, billId])
  @@map("bill_payments")
}

// ---------------------------------------------------------------------------
// Accounting: a double-entry journal. Documents post entries automatically;
// reports are sums over journal lines.
// ---------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      AccountType
  /// Set on the accounts automatic postings use (RECEIVABLE, SALES, ...).
  systemKey String?       @map("system_key")
  archived  Boolean       @default(false)
  createdAt DateTime      @default(now()) @map("created_at")
  lines     JournalLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@unique([tenantId, systemKey])
  @@map("accounts")
}

enum JournalSource {
  MANUAL
  INVOICE
  INVOICE_PAYMENT
  BILL
  BILL_PAYMENT
  STOCK
  POS_ORDER
  POS_SESSION
}

model JournalEntry {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String
  date        DateTime      @db.Date
  memo        String?
  source      JournalSource
  /// The invoice, bill, payment or stock move that produced this entry.
  sourceId    String?       @map("source_id") @db.Uuid
  /// Human-readable source, e.g. INV-00001.
  reference   String?
  /// Set on an entry that cancels another one.
  reversesId  String?       @map("reverses_id") @db.Uuid
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  lines       JournalLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([tenantId, source, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId     String       @map("entry_id") @db.Uuid
  entry       JournalEntry @relation(fields: [entryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  accountId   String       @map("account_id") @db.Uuid
  account     Account      @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: NoAction)
  contactId   String?      @map("contact_id") @db.Uuid
  contact     Contact?     @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: NoAction)
  description String?
  debit       Decimal      @default(0) @db.Decimal(14, 2)
  credit      Decimal      @default(0) @db.Decimal(14, 2)
  /// Copied from the entry so reports can filter by date without a join.
  date        DateTime     @db.Date

  @@index([tenantId, accountId, date])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Platform (the SaaS operator's side). These tables are not tenant-scoped,
// except platform_invoices, whose RLS policy also lets the platform console in.

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  SUSPENDED
  CANCELED
}

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(14, 2)
  currency     String   @default("PKR")
  /// null means unlimited
  maxUsers     Int?     @map("max_users")
  description  String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  tenants      Tenant[]

  @@map("plans")
}

model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("platform_admins")
}

enum PlatformInvoiceStatus {
  OPEN
  PAID
  VOID
}

/// What a company owes the platform for one subscription period.
model PlatformInvoice {
  id          String   @id @default(uuid()) @db.Uuid
  number      String   @unique
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planCode    String   @map("plan_code")
  planName    String   @map("plan_name")
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  dueDate     DateTime @map("due_date")
  status      PlatformInvoiceStatus @default(OPEN)
  /// Bank transfer or wallet reference the company reported.
  paymentReference String?   @map("payment_reference")
  reportedAt       DateTime? @map("reported_at")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("platform_invoices")
}

// ---------------------------------------------------------------------------
// Point of sale

/// A till: which warehouse it sells from and how its prices are taxed.
model PosRegister {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  warehouseId      String       @map("warehouse_id") @db.Uuid
  warehouse        Warehouse    @relation(fields: [warehouseId, tenantId], references: [id, tenantId], onDelete: NoAction)
  taxId            String?      @map("tax_id") @db.Uuid
  tax              Tax?         @relation(fields: [taxId, tenantId], references: [id, tenantId], onDelete: NoAction)
  /// Shelf prices already include the tax (usual in retail).
  pricesIncludeTax Boolean      @default(true) @map("prices_include_tax")
  /// Printed at the bottom of receipts.
  receiptFooter    String?      @map("receipt_footer")
  archived         Boolean      @default(false)
  createdAt        DateTime     @default(now()) @map("created_at")
  sessions         PosSession[]

  @@unique([id, tenantId])
  @@map("pos_registers")
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

/// One cashier shift on a register, from opening float to cash count.
model PosSession {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number       String
  registerId   String           @map("register_id") @db.Uuid
  register     PosRegister      @relation(fields: [registerId, tenantId], references: [id, tenantId], onDelete: NoAction)
  status       PosSessionStatus @default(OPEN)
  openingCash  Decimal          @map("opening_cash") @db.Decimal(14, 2)
  openedById   String           @map("opened_by_id") @db.Uuid
  openedAt     DateTime         @default(now()) @map("opened_at")
  expectedCash Decimal?         @map("expected_cash") @db.Decimal(14, 2)
  countedCash  Decimal?         @map("counted_cash") @db.Decimal(14, 2)
  /// counted minus expected; negative means cash is missing.
  difference   Decimal?         @db.Decimal(14, 2)
  closingNote  String?          @map("closing_note")
  closedById   String?          @map("closed_by_id") @db.Uuid
  closedAt     DateTime?        @map("closed_at")
  orders       PosOrder[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@map("pos_sessions")
}

enum PosOrderStatus {
  PAID
  REFUNDED
}

/// A completed sale (or, with refundOfId set, a refund with negative amounts).
model PosOrder {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String
  sessionId   String         @map("session_id") @db.Uuid
  session     PosSession     @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: NoAction)
  customerId  String?        @map("customer_id") @db.Uuid
  customer    Contact?       @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: NoAction)
  status      PosOrderStatus @default(PAID)
  refundOfId  String?        @map("refund_of_id") @db.Uuid
  refundOf    PosOrder?      @relation("PosRefunds", fields: [refundOfId, tenantId], references: [id, tenantId], onDelete: NoAction)
  refunds     PosOrder[]     @relation("PosRefunds")
  subtotal    Decimal        @db.Decimal(14, 2)
  taxTotal    Decimal        @map("tax_total") @db.Decimal(14, 2)
  total       Decimal        @db.Decimal(14, 2)
  /// What the customer handed over; change = tendered - total.
  tendered    Decimal        @db.Decimal(14, 2)
  change      Decimal        @default(0) @db.Decimal(14, 2)
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  lines       PosOrderLine[]
  payments    PosPayment[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, sessionId])
  @@map("pos_orders")
}

model PosOrderLine {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     String   @map("order_id") @db.Uuid
  order       PosOrder @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  position    Int
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: NoAction)
  description String
  quantity    Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  discountPct Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(6, 3)
  subtotal    Decimal  @db.Decimal(14, 2)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)

  @@index([tenantId, orderId])
  @@map("pos_order_lines")
}

model PosPayment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String   @map("order_id") @db.Uuid
  order     PosOrder @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  /// CASH, CARD or WALLET (JazzCash, Easypaisa and the like).
  method    String
  /// Amount kept: cash is net of change. Negative on refunds.
  amount    Decimal  @db.Decimal(14, 2)
  reference String?

  @@index([tenantId, orderId])
  @@map("pos_payments")
}

// ---------------------------------------------------------------------------
// CRM

/// A column of the sales pipeline. Won and lost stages close the lead.
model CrmStage {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  /// Chance of winning, in percent, used for the weighted pipeline.
  probability Int       @default(0)
  isWon       Boolean   @default(false) @map("is_won")
  isLost      Boolean   @default(false) @map("is_lost")
  archived    Boolean   @default(false)
  leads       CrmLead[]

  @@unique([id, tenantId])
  @@map("crm_stages")
}

/// A lead or opportunity. It can start as a bare prospect and be linked to a contact later.
model CrmLead {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  stageId         String      @map("stage_id") @db.Uuid
  stage           CrmStage    @relation(fields: [stageId, tenantId], references: [id, tenantId], onDelete: NoAction)
  contactId       String?     @map("contact_id") @db.Uuid
  contact         Contact?    @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: NoAction)
  /// Prospect details, used until the lead is linked to a contact.
  companyName     String?     @map("company_name")
  personName      String?     @map("person_name")
  email           String?
  phone           String?
  /// Where the lead came from: website, referral, walk-in...
  source          String?
  /// The salesperson (a user id).
  ownerId         String?     @map("owner_id") @db.Uuid
  expectedRevenue Decimal     @default(0) @map("expected_revenue") @db.Decimal(14, 2)
  expectedClose   DateTime?   @map("expected_close") @db.Date
  /// 0 to 3 stars.
  priority        Int         @default(0)
  notes           String?
  lostReason      String?     @map("lost_reason")
  closedAt        DateTime?   @map("closed_at")
  /// The quotation the lead was turned into.
  salesOrderId    String?     @map("sales_order_id") @db.Uuid
  salesOrder      SalesOrder? @relation(fields: [salesOrderId, tenantId], references: [id, tenantId], onDelete: NoAction)
  archived        Boolean     @default(false)
  createdById     String      @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  activities      CrmActivity[]

  @@unique([id, tenantId])
  @@index([tenantId, stageId])
  @@map("crm_leads")
}

enum CrmActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
}

/// A planned or logged interaction on a lead. Notes are logged as done straight away.
model CrmActivity {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String          @map("lead_id") @db.Uuid
  lead         CrmLead         @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  type         CrmActivityType
  summary      String
  dueAt        DateTime?       @map("due_at")
  doneAt       DateTime?       @map("done_at")
  assignedToId String?         @map("assigned_to_id") @db.Uuid
  createdById  String          @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([tenantId, leadId])
  @@index([tenantId, assignedToId, doneAt])
  @@map("crm_activities")
}
